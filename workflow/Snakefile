import json
import os
import shlex
import sys
from pathlib import Path

# Rules run their scripts with bare `python`; make that the interpreter running
# Snakemake (the project venv) however Snakemake was started.
os.environ["PATH"] = f"{Path(sys.executable).parent}{os.pathsep}{os.environ['PATH']}"

configfile: "config/config.yaml"
# Each person's own settings, which override the shared ones key by key.
LOCAL_CONFIG = Path(workflow.basedir).parent / "config" / "config.local.yaml"
if LOCAL_CONFIG.exists():
    configfile: str(LOCAL_CONFIG)

SCRIPTS = Path(workflow.basedir) / "scripts"

sys.path.insert(0, str(SCRIPTS))
sys.path.insert(0, str(SCRIPTS / "sources"))
import babel
import local_config
import webhost

# Stop now, with a clear message, if anything only you can supply is missing.
if unset := local_config.missing_settings(
        config, keys=(*local_config.REQUIRED_PATHS, "graph_version")):
    raise ValueError(f"Missing settings: {', '.join(unset)}. {local_config.SETUP_HINT}")

OUTPUT_ROOT = Path(config["output_root"])

# The Tier0 graph is placed by hand under {graph_root}/YYYYMMDD/ (the graph's
# build date), and graph_version says which one to build.
GRAPH_ROOT = Path(config["graph_root"])
GRAPH_FILES = ("nodes.jsonl", "edges.jsonl", "graph-metadata.json")
VERSION = str(config["graph_version"])
KGX_DIR = GRAPH_ROOT / VERSION
if missing := [f for f in GRAPH_FILES if not (KGX_DIR / f).exists()]:
    raise ValueError(f"Graph {KGX_DIR} is missing {', '.join(missing)}")
print(f"Tier0: using {VERSION} from {KGX_DIR}", file=sys.stderr)

# The Biolink and Babel versions are the ones the graph was built with, as
# recorded in its graph-metadata.json, so the artifacts always match the graph.
# Newer metadata files use the translator: keys, older ones the bare names.
GRAPH_METADATA = KGX_DIR / "graph-metadata.json"
_graph_metadata = json.loads(GRAPH_METADATA.read_text())


def graph_metadata_version(name: str) -> str:
    """The graph's recorded version of name (e.g. "babelVersion")."""
    for key in (f"translator:{name}", name):
        if _graph_metadata.get(key):
            return str(_graph_metadata[key])
    raise ValueError(f"{GRAPH_METADATA} records no {name} (translator:{name})")


BIOLINK_VERSION = graph_metadata_version("biolinkVersion")

# Babel: the sqlite built from the graph's babelVersion, at the highest patch
# released for it on stitch-proj. A local copy of that patch in babel_dir is
# used; otherwise the fetch rule downloads it.
BABEL_VERSION = graph_metadata_version("babelVersion")
BABEL_SQLITE, BABEL_RELEASE = babel.resolve(
    Path(config["babel_dir"]), BABEL_VERSION, config["babel_releases"])
print(f"Biolink: {BIOLINK_VERSION}", file=sys.stderr)

# DrugBank: the newest of what is local and what is on the webhost (or a
# version pinned in the config). Only the listing is fetched here; the fetch
# rule downloads a version when its local file is missing.
WEBHOST = config["webhost"]
DRUGBANK_DIR = Path(config["drugbank_dir"])
DRUGBANK_VERSION = webhost.resolve(
    "DrugBank",
    webhost.local_drugbank_versions(DRUGBANK_DIR),
    lambda: {v} if (v := webhost.remote_drugbank_version(WEBHOST, config["webhost_drugbank"])) else set(),
    config.get("drugbank_version"),
)

TIER0 = f"tier0-{VERSION}"
DRUGBANK_XML = DRUGBANK_DIR / f"drugbank-{DRUGBANK_VERSION}.xml"

BUILD_DIR = OUTPUT_ROOT / VERSION
LOG_DIR = BUILD_DIR / "logs"
BENCH_DIR = BUILD_DIR / "benchmarks"

AUTOCOMPLETE_DB = BUILD_DIR / f"autocomplete_v1.0_{TIER0}.sqlite"
OVERLAY_DB = BUILD_DIR / f"tier0-info-for-overlay_v1.0_{TIER0}.sqlite"
CURIE_TO_PMIDS_DB = BUILD_DIR / f"curie_to_pmids_v1.0_{TIER0}.sqlite"
CURIE_NGD_DB = BUILD_DIR / f"curie_ngd_v1.0_{TIER0}.sqlite"
FDA_DRUGS_PICKLE = BUILD_DIR / "fda_approved_drugs_v1.0.pickle"
PUBMED_MANIFEST = BUILD_DIR / "pubmed_manifest.json"
CONFIG_DBS = BUILD_DIR / "config_dbs.json"

# Artifacts that get staged for release. Each one gets an md5 in MD5_DIR;
# asking for the md5 makes Snakemake build the artifact first.
MD5_DIR = BUILD_DIR / "md5_sums"
RELEASE_ARTIFACTS = [AUTOCOMPLETE_DB, OVERLAY_DB, CURIE_TO_PMIDS_DB, CURIE_NGD_DB, FDA_DRUGS_PICKLE]

# Scratch space for intermediates, deleted by the rules that use it. The
# Biolink lookup cache is shared across builds.
WORK_DIR = BUILD_DIR / "work"
BIOLINK_CACHE_DIR = OUTPUT_ROOT / ".cache" / "biolink"

TEST_RESULTS_DIR = BUILD_DIR / "test_results"
ARTIFACT_TEST_RESULTS = TEST_RESULTS_DIR / "artifacts.xml"
CONFIG_DBS_TEST_RESULTS = TEST_RESULTS_DIR / "config_dbs.xml"
ARTIFACT_STATS = BUILD_DIR / "artifact_stats.json"
BUILD_REPORT = BUILD_DIR / "build_report.md"
# Each build's report, counts, logs and test results are kept in the repo,
# under builds/YYYYMMDD/ like the artifacts, so they outlive the artifacts.
RECORDS_ROOT = Path(workflow.basedir).parent / "builds"


def artifact_log(artifact: Path) -> Path:
    """The log of the rule that builds artifact, named after the artifact."""
    return LOG_DIR / f"{artifact.name}.log"


def artifact_benchmark(artifact: Path) -> Path:
    """The benchmark of the rule that builds artifact, named after the artifact."""
    return BENCH_DIR / f"{artifact.name}.tsv"


# Rules delete their own scratch files; drop the scratch directory once a run
# has finished with nothing left in it.
onsuccess:
    if WORK_DIR.is_dir() and not any(WORK_DIR.iterdir()):
        WORK_DIR.rmdir()


# Everything Snakemake does: build, test and report. Staging, the RTX PR and the
# build record are run by ./autobuild, only when asked for.
rule all:
    input:
        [MD5_DIR / f"{artifact.name}.md5" for artifact in RELEASE_ARTIFACTS],
        CONFIG_DBS,
        BUILD_REPORT,


include: "rules/sources.smk"
include: "rules/autocomplete.smk"
include: "rules/overlay.smk"
include: "rules/curie_pmids.smk"
include: "rules/curie_ngd.smk"
include: "rules/fda_drugs.smk"
include: "rules/md5.smk"
include: "rules/arax_config.smk"
include: "rules/report.smk"
